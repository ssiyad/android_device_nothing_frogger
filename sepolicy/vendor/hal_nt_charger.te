# hal_nt_charger walks /sys/devices/virtual to reach
# /sys/devices/virtual/thermal, then reads /sys/class/thermal/*/type.
#
#   avc: denied { open read } path="/sys/devices/virtual"
#        scontext=u:r:hal_nt_charger:s0 tcontext=u:object_r:sysfs:s0 tclass=dir
#
# Everything it consumes is already labelled and allowed by
# hardware/nothing/sepolicy/common/vendor/hal_nt_charger.te. The gap is the
# generic parent directory it opens to get there.
#
# This grants directory read only -- listing entries, not file contents. A
# genfscon for /devices/virtual would match by prefix and relabel everything
# beneath that path which is not more specifically labelled, changing what other
# domains see.
allow hal_nt_charger sysfs:dir r_dir_perms;
