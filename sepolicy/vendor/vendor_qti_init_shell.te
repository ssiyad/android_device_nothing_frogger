# Deliberately no rules. Same neverallow as hal_thermal_default.te.
#
#   avc: denied { add_name write } scontext=u:r:vendor_qti_init_shell:s0
#        tcontext=u:object_r:sysfs_transparent_hugepage:s0 tclass=dir
#   avc: denied { create } name="defrag" ... tclass=file
#
# A shell `> file` redirect passes O_CREAT, which produces the create check on
# an existing node.
