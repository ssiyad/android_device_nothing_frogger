# Deliberately no rules.
#
#   avc: denied { add_name write } scontext=u:r:hal_thermal_default:s0
#        tcontext=u:object_r:sysfs_thermal:s0 tclass=dir
#   avc: denied { create } name="trip_point_1_temp" ... tclass=file
#
# domain.te neverallows sysfs_type:dir { add_name create write } for every
# domain, so this cannot be granted. The HAL walks all 72 thermal zones and
# fopen(path, "w") passes O_CREAT, so the 18 that do not expose
# trip_point_1_temp register as creation attempts. Zones that do expose it are
# written normally; only create is denied, never file write.
