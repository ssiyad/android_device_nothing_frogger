# Deliberately no rules. Same neverallow as hal_thermal_default.te.
#
#   avc: denied { add_name write } scontext=u:r:vendor_nicmd:s0
#        tcontext=u:object_r:sysfs_net:s0 tclass=dir
#   avc: denied { create } name="rps_cpus" ... tclass=file
#
# All 38 rx queues expose rps_cpus, so the trigger is a probe made before the
# interface exists. Only create is denied, never file write.
