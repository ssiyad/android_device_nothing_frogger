android_app {
    name: "Glyph",

    srcs: ["src/**/*.java"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,
    optimize: {
        enabled: false,
    },
    required: [
        "default_permissions_org.lineageos.glyph",
    ],
}

prebuilt_etc {
    name: "default_permissions_org.lineageos.glyph",
    sub_dir: "default-permissions",
    src: "default-permissions-org.lineageos.glyph.xml",
    filename_from_src: true,
    system_ext_specific: true,
}
