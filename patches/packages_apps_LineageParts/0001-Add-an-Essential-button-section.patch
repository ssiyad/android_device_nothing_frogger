diff --git a/src/org/lineageos/lineageparts/input/EssentialButtonPreferences.java b/src/org/lineageos/lineageparts/input/EssentialButtonPreferences.java
new file mode 100644
index 0000000..fb1cd48
--- /dev/null
+++ b/src/org/lineageos/lineageparts/input/EssentialButtonPreferences.java
@@ -0,0 +1,164 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.lineageparts.input;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.provider.Settings;
+import android.util.Log;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.PreferenceFragmentCompat;
+
+/**
+ * The Essential Button's three gestures, for devices that have the key.
+ *
+ * The rows are marked non-persistent and read and written by hand, because the
+ * values live in Settings.System rather than in this app: the half of the
+ * EssentialButton app that acts on them runs inside system_server and can see
+ * nothing else. The tokens here have to match its Constants.
+ *
+ * "Open application" is a list entry whose stored value is not the entry value.
+ * Choosing it opens the picker in the app that owns the key, and that picker
+ * writes the chosen component itself -- so nothing is stored until an app is
+ * actually chosen, backing out leaves the gesture as it was, and no result has
+ * to be carried back across the two packages. Coming back to this screen is what
+ * shows the change, which is why onResume refreshes.
+ *
+ * All of this lives in its own file so that carrying it costs two lines in
+ * ButtonSettings and nothing that upstream is likely to touch.
+ */
+public final class EssentialButtonPreferences implements Preference.OnPreferenceChangeListener {
+    private static final String TAG = "EssentialButtonPreferences";
+
+    private static final String CATEGORY = "essential_button";
+
+    private static final String[] KEYS = {
+            "essential_button_single_press",
+            "essential_button_double_press",
+            "essential_button_long_press",
+    };
+
+    /** Not an action, only the list entry that leads to the picker. */
+    private static final String ENTRY_OPEN_APP = "open_app";
+
+    /** Followed by a flattened ComponentName. */
+    private static final String APP_PREFIX = "app:";
+
+    private static final String PICKER_ACTION = "org.lineageos.essentialbutton.PICK_APP";
+    private static final String EXTRA_SETTING = "setting";
+
+    private static final String DEFAULT_SINGLE_PRESS = "screenshot";
+    private static final String DEFAULT_OTHER = "none";
+
+    private final PreferenceFragmentCompat mFragment;
+
+    private EssentialButtonPreferences(PreferenceFragmentCompat fragment) {
+        mFragment = fragment;
+    }
+
+    /**
+     * Takes the section away on any device without the key, which is every
+     * device whose build does not carry the app that answers the picker.
+     */
+    public static void setup(PreferenceFragmentCompat fragment) {
+        final PreferenceCategory category = fragment.findPreference(CATEGORY);
+        if (category == null) {
+            return;
+        }
+        if (!hasEssentialButton(fragment.getContext())) {
+            fragment.getPreferenceScreen().removePreference(category);
+            return;
+        }
+
+        final EssentialButtonPreferences listener = new EssentialButtonPreferences(fragment);
+        for (String key : KEYS) {
+            final ListPreference preference = fragment.findPreference(key);
+            if (preference != null) {
+                preference.setPersistent(false);
+                preference.setOnPreferenceChangeListener(listener);
+            }
+        }
+        refresh(fragment);
+    }
+
+    /** Re-reads every row, which is how a pick made in the other app shows up. */
+    public static void refresh(PreferenceFragmentCompat fragment) {
+        if (fragment.findPreference(CATEGORY) == null) {
+            return;
+        }
+        for (String key : KEYS) {
+            final ListPreference preference = fragment.findPreference(key);
+            if (preference != null) {
+                refresh(preference);
+            }
+        }
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object value) {
+        final String key = preference.getKey();
+
+        if (ENTRY_OPEN_APP.equals(value)) {
+            mFragment.startActivity(new Intent(PICKER_ACTION)
+                    .putExtra(EXTRA_SETTING, key));
+            return false;
+        }
+
+        store(preference.getContext(), key, (String) value);
+        refresh((ListPreference) preference);
+        return false;
+    }
+
+    private static void store(Context context, String key, String value) {
+        Settings.System.putString(context.getContentResolver(), key, value);
+    }
+
+    private static void refresh(ListPreference preference) {
+        final Context context = preference.getContext();
+        final String stored = read(context, preference.getKey());
+
+        if (stored.startsWith(APP_PREFIX)) {
+            preference.setValue(ENTRY_OPEN_APP);
+            preference.setSummary(labelOf(context, stored.substring(APP_PREFIX.length())));
+            return;
+        }
+
+        preference.setValue(stored);
+        preference.setSummary(preference.getEntry());
+    }
+
+    private static String read(Context context, String key) {
+        final String value = Settings.System.getString(context.getContentResolver(), key);
+        if (value != null) {
+            return value;
+        }
+        return KEYS[0].equals(key) ? DEFAULT_SINGLE_PRESS : DEFAULT_OTHER;
+    }
+
+    /** Falls back to the flattened name, so an uninstalled app still reads as something. */
+    private static CharSequence labelOf(Context context, String flattened) {
+        final ComponentName component = ComponentName.unflattenFromString(flattened);
+        final PackageManager pm = context.getPackageManager();
+        if (component != null) {
+            try {
+                return pm.getActivityInfo(component, 0).loadLabel(pm);
+            } catch (PackageManager.NameNotFoundException e) {
+                Log.w(TAG, "Gone: " + flattened);
+            }
+        }
+        return flattened;
+    }
+
+    private static boolean hasEssentialButton(Context context) {
+        return context.getPackageManager().resolveActivity(new Intent(PICKER_ACTION),
+                PackageManager.ResolveInfoFlags.of(PackageManager.MATCH_SYSTEM_ONLY)) != null;
+    }
+}
