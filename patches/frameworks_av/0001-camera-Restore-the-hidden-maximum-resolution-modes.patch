+// Nothing's camera HAL describes full-resolution capture completely -- maximum
+// resolution active array, pixel array, binning factor, minimum frame durations,
+// stall durations and input/output formats map are all populated -- but leaves
+// ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_MAXIMUM_RESOLUTION empty and
+// omits the matching capability, so no application can reach those modes. The
+// configurations themselves are published under a vendor tag, as a superset of
+// the default-pixel-mode list; the entries missing from that list are exactly
+// the full-resolution set. Reinstate them so the standard maximum resolution
+// path works.
+static constexpr uint32_t kNothingScalerAvailableStreamConfigurations = 0x80c50000;
+
+status_t CameraProviderManager::ProviderInfo::DeviceInfo3::addNothingUltraHighResolutionTags() {
+    auto& c = mCameraCharacteristics;
+
+    // Act only where the HAL already describes full-resolution capture. These
+    // companions are populated on the quad-bayer sensors alone, which keeps the
+    // resulting characteristics self-consistent and leaves every other camera,
+    // and every other device, untouched.
+    if (c.find(ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS_MAXIMUM_RESOLUTION).count == 0 ||
+            c.find(ANDROID_SENSOR_INFO_ACTIVE_ARRAY_SIZE_MAXIMUM_RESOLUTION).count == 0 ||
+            c.find(ANDROID_SENSOR_INFO_PIXEL_ARRAY_SIZE_MAXIMUM_RESOLUTION).count == 0 ||
+            c.find(ANDROID_SENSOR_INFO_BINNING_FACTOR).count == 0) {
+        return OK;
+    }
+    if (c.find(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_MAXIMUM_RESOLUTION).count != 0) {
+        return OK;
+    }
+
+    auto vendorConfigs = c.find(kNothingScalerAvailableStreamConfigurations);
+    auto defaultConfigs = c.find(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS);
+    if (vendorConfigs.count == 0 || defaultConfigs.count == 0 ||
+            (vendorConfigs.count % 4) != 0 || (defaultConfigs.count % 4) != 0) {
+        return OK;
+    }
+
+    // Entries are [format, width, height, direction] in both lists.
+    typedef std::array<int32_t, 4> StreamConfig;
+    std::set<StreamConfig> defaultSet;
+    for (size_t i = 0; i < defaultConfigs.count; i += 4) {
+        defaultSet.insert({defaultConfigs.data.i32[i], defaultConfigs.data.i32[i + 1],
+                defaultConfigs.data.i32[i + 2], defaultConfigs.data.i32[i + 3]});
+    }
+
+    // The vendor list repeats some entries; keep the first of each.
+    std::set<StreamConfig> emitted;
+    std::vector<int32_t> maxResolutionConfigs;
+    for (size_t i = 0; i < vendorConfigs.count; i += 4) {
+        StreamConfig entry = {vendorConfigs.data.i32[i], vendorConfigs.data.i32[i + 1],
+                vendorConfigs.data.i32[i + 2], vendorConfigs.data.i32[i + 3]};
+        if (defaultSet.find(entry) != defaultSet.end()) continue;
+        if (!emitted.insert(entry).second) continue;
+        maxResolutionConfigs.insert(maxResolutionConfigs.end(), entry.begin(), entry.end());
+    }
+    if (maxResolutionConfigs.empty()) {
+        return OK;
+    }
+
+    status_t res = c.update(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_MAXIMUM_RESOLUTION,
+            maxResolutionConfigs.data(), maxResolutionConfigs.size());
+    if (res != OK) {
+        ALOGE("%s: Failed to set maximum resolution stream configurations: %s (%d)",
+                __FUNCTION__, strerror(-res), res);
+        return res;
+    }
+
+    auto capabilities = c.find(ANDROID_REQUEST_AVAILABLE_CAPABILITIES);
+    if (capabilities.count == 0) {
+        ALOGE("%s: No available capabilities!", __FUNCTION__);
+        return BAD_VALUE;
+    }
+    std::vector<uint8_t> newCapabilities(capabilities.data.u8,
+            capabilities.data.u8 + capabilities.count);
+    if (std::find(newCapabilities.begin(), newCapabilities.end(),
+            ANDROID_REQUEST_AVAILABLE_CAPABILITIES_ULTRA_HIGH_RESOLUTION_SENSOR) ==
+            newCapabilities.end()) {
+        newCapabilities.push_back(
+                ANDROID_REQUEST_AVAILABLE_CAPABILITIES_ULTRA_HIGH_RESOLUTION_SENSOR);
+        res = c.update(ANDROID_REQUEST_AVAILABLE_CAPABILITIES, newCapabilities.data(),
+                newCapabilities.size());
+        if (res != OK) {
+            ALOGE("%s: Failed to add ULTRA_HIGH_RESOLUTION_SENSOR: %s (%d)", __FUNCTION__,
+                    strerror(-res), res);
+            return res;
+        }
+    }
+
+    // The HAL already lists the configurations tag among its characteristics
+    // keys; add it only if some future build stops doing so.
+    auto characteristicsKeys = c.find(ANDROID_REQUEST_AVAILABLE_CHARACTERISTICS_KEYS);
+    if (characteristicsKeys.count != 0) {
+        std::vector<int32_t> newKeys(characteristicsKeys.data.i32,
+                characteristicsKeys.data.i32 + characteristicsKeys.count);
+        if (std::find(newKeys.begin(), newKeys.end(),
+                ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_MAXIMUM_RESOLUTION) ==
+                newKeys.end()) {
+            newKeys.push_back(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_MAXIMUM_RESOLUTION);
+            res = c.update(ANDROID_REQUEST_AVAILABLE_CHARACTERISTICS_KEYS, newKeys.data(),
+                    newKeys.size());
+        }
+    }
+
+    ALOGI("%s: Restored %zu maximum resolution stream configurations", __FUNCTION__,
+            maxResolutionConfigs.size() / 4);
+    return res;
+}
