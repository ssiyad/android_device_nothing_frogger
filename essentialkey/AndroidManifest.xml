<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.essentialkey"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <application
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:label="@string/essential_key_title">

        <!-- The gesture rows are drawn by LineageParts, under
             Settings > System > Buttons, so this app has no settings screen of
             its own and deliberately no MAIN/LAUNCHER filter. The picker is all
             that screen cannot draw for itself, and this action is how it is
             reached.

             Exported because the caller is another package. LineageParts also
             resolves this action to decide whether the device has the key at
             all, and takes the whole section away when nothing answers, so the
             filter is also what makes the section appear. The key handed over
             is checked against the three gestures before anything is written. -->
        <activity
            android:name=".ui.AppPickerActivity"
            android:exported="true"
            android:label="@string/action_open_app"
            android:theme="@style/Theme.SubSettingsBase.Expressive">
            <intent-filter>
                <action android:name="org.lineageos.essentialkey.PICK_APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
