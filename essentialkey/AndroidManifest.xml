<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.essentialkey"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <application
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:label="@string/essential_key_title">

        <!-- This action is the hook the buttons screen already offers for a
             key the device has and Lineage does not know about: its Extras
             category carries a RemotePreference declaring
             lineage:requiresAction for exactly this, and SelfRemovingPreference
             takes the entry away again on any device where nothing answers.
             Answering it is the whole of what puts this under
             Settings > System > Buttons, so there is deliberately no
             MAIN/LAUNCHER filter and no Settings tile.

             The resolve is queryIntentActivitiesAsUser with MATCH_SYSTEM_ONLY
             and a FLAG_SYSTEM test, so this only works while the app is on the
             system image. -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/essential_key_title"
            android:theme="@style/Theme.SubSettingsBase.Expressive">
            <intent-filter>
                <action android:name="org.lineageos.settings.device.ADDITIONAL_BUTTONS_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AppPickerActivity"
            android:exported="false"
            android:label="@string/action_open_app"
            android:theme="@style/Theme.SubSettingsBase.Expressive" />
    </application>
</manifest>
