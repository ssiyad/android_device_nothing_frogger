android_app {
    name: "EssentialKey",

    defaults: ["SettingsLibDefaults"],
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "com.google.android.material_material",
    ],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,

    // Deliberately not privileged: sharing android.uid.system already confers
    // everything this needs, and a privileged app asking for a
    // signature|privileged permission missing from a whitelist aborts the boot.
    // It also decides the install path, which config_deviceKeyHandlerLibs names
    // literally -- see docs/reference/essential-key.md.

    // KeyHandler is only ever reached reflectively, from system_server. R8
    // cannot see that and would rename or drop it.
    optimize: {
        enabled: false,
    },
}
