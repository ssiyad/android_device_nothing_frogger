# A/B
ro.virtual_ab.compression.threads=true
ro.virtual_ab.merge_delay_seconds=40

# Adreno
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno
ro.opengles.version=196610

# Audio
aaudio.hw_burst_min_usec=2000
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
af.fast_track_multiplier=1
audio.deep_buffer.media=true
audio.offload.video=true
persist.bluetooth.a2dp_offload.disabled=false
ro.af.client_heap_size_kbyte=7168
ro.audio.flinger_standbytime_ms=2000
ro.bluetooth.a2dp_offload.supported=true
vendor.audio.adm.buffering.ms=2
vendor.audio.feature.a2dp_offload.enable=true
vendor.audio.feature.afe_proxy.enable=true
vendor.audio.feature.battery_listener.enable=true
vendor.audio.feature.hfp.enable=true
vendor.audio.feature.kpi_optimize.enable=true
vendor.audio.offload.buffer.size.kb=256
vendor.audio.offload.playspeed=true
vendor.audio.ull_record_period_multiplier=2
vendor.audio.volume.headset.gain.depcal=true
vendor.audio_hal.period_size=192

# Bluetooth
bluetooth.profile.bap.broadcast.assist.enabled=true
bluetooth.profile.bap.broadcast.source.enabled=true
bluetooth.profile.bap.unicast.client.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.ccp.server.enabled=true
bluetooth.profile.csip.set_coordinator.enabled=true
bluetooth.profile.hap.client.enabled=true
bluetooth.profile.mcp.server.enabled=true
bluetooth.profile.vcp.controller.enabled=true
persist.sys.fflag.override.settings_bluetooth_hearing_aid=true
persist.vendor.bluetooth.modem_nv_support=true
persist.vendor.qcom.bluetooth.a2dp_mcast_test.enabled=false
persist.vendor.qcom.bluetooth.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac-aptxadaptiver2
persist.vendor.qcom.bluetooth.aac_frm_ctl.enabled=true
persist.vendor.qcom.bluetooth.aptxadaptiver2_1_support=true
persist.vendor.qcom.bluetooth.scram.enabled=false
persist.vendor.qcom.bluetooth.twsp_state.enabled=false
vendor.hw.fm.init=0

# Camera
camera.disable_zsl_mode=1
ro.camera.enableCamera1MaxZsl=1
ro.camera.disableHeicUltraHDR=true

# Display 
vendor.display.comp_mask=0
vendor.display.disable_3d_adaptive_tm=1
vendor.display.disable_cwb_idle_fallback=1
vendor.display.disable_dynamic_fps=1
vendor.display.disable_excl_rect=0
vendor.display.disable_excl_rect_partial_fb=1
vendor.display.disable_hw_recovery_dump=1
vendor.display.disable_offline_rotator=1
vendor.display.disable_scaler=0
vendor.display.disable_sdr_dimming=0
vendor.display.disable_sdr_histogram=1
vendor.display.disable_stc_dimming=1
vendor.display.enable_async_vds_creation=1
vendor.display.enable_dpps_dynamic_fps=1
vendor.display.enable_hdr10_gpu_target=1
vendor.display.enable_optimize_refresh=0
vendor.display.enable_rounded_corner=1
vendor.display.vds_allow_hwc=1
vendor.gralloc.disable_ubwc=0
vendor.gralloc.enable_logs=0

# DPM
persist.vendor.dpm.vndr.feature=11
persist.vendor.dpm.vndr.halservice.enable=1
persist.vendor.dpm.vndr.idletimer.mode=default

# FRP 
ro.frp.pst=/dev/block/bootdevice/by-name/frp

# FUSE
persist.sys.fuse.passthrough.enable=true

# Fingerprint
ro.vendor.fingerprint.type=udfps_optical
ro.vendor.fingerprint.sensor_location=612|2485|103

# Graphics
debug.angle.feature_overrides_enabled=preferLinearFilterForYUV:mapUnspecifiedColorSpaceToPassThrough
debug.graphics.game_default_frame_rate.disabled=0
debug.hwui.target_cpu_time_percent=40
debug.hwui.use_hint_manager=true
debug.sf.auto_latch_unsignaled=1
debug.sf.early.app.duration=13666666
debug.sf.early.sf.duration=10500000
debug.sf.earlyGl.app.duration=13666666
debug.sf.earlyGl.sf.duration=10500000
debug.sf.enable_adpf_cpu_hint=true
# AOSP defaults this to true (SurfaceFlinger.cpp:533 GetBoolProperty(..., true))
# and stock sets 1. We were explicitly disabling it, inherited from Asteroids.
# It gates whether SurfaceFlinger applies backpressure when GPU composition
# would miss a frame, so switching it off degrades frame pacing.
debug.sf.enable_gl_backpressure=1
debug.sf.late.app.duration=13666666
debug.sf.late.sf.duration=10500000
debug.sf.predict_hwc_composition_strategy=0
debug.sf.treat_170m_as_sRGB=1
debug.sf.use_phase_offsets_as_durations=1
# Stock sets persist.sys.sf.native_mode=260. That is a *vendor* display colour
# setting: SurfaceFlinger casts it straight to a RenderIntent
# (CompositionEngine/src/Output.cpp, "default: // vendor display color setting"),
# and vendor render intents start at 256. Stock's display HAL advertises intent
# 260 because its colour management is fully initialised; ours advertises only
# ColorMode::NATIVE with COLORIMETRIC, so 260 matches nothing.
#
# The result was every frame logging
#   "map unknown (BT709 sRGB Full range)/(Unknown RenderIntent) to default color mode"
# and Night Light having no visible effect: the framework computed the correct
# tint matrix and SurfaceFlinger held it, but the colour pipeline was running on
# an invalid render intent.
#
# 0 is kManaged. We were shipping 260 ourselves, inherited from Asteroids, not
# merely picking it up from stock. Note it is a persist property, so on a device
# that already holds 260 in /data the stored value wins and it must be reset once
# with setprop.
persist.sys.sf.native_mode=0

ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.game_default_frame_rate_override=60
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.has_wide_color_display=true
# Sizes SurfaceFlinger's own framebuffer (NUM_FRAMEBUFFER_SURFACE_BUFFERS), which
# is on the critical path whenever SF falls back to client composition. AOSP
# defaults to 2 (SurfaceFlinger.cpp max_frame_buffer_acquired_buffers(2)); stock
# sets 3, and we were taking the default while shipping stock's phase durations.
# Those durations describe a pipeline 13.67ms app + 10.5ms SF = 24.2ms deep,
# which at 120Hz is ~2.9 vsync periods against only 2 buffers, so the producer
# blocks in dequeueBuffer/waitForBufferRelease instead of pipelining.
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.max_virtual_display_dimension=4096
ro.surface_flinger.protected_contents=true
# Stock uses 550 here. Deliberately NOT matching it yet: a shorter idle timer
# means SurfaceFlinger drops to the idle refresh rate sooner and therefore
# switches refresh rate MORE often, and refresh-rate transitions are the current
# prime suspect for the screen flicker -- pinning 120Hz is the only thing that
# has stopped it. Stock also pairs 550 with ro.vendor.display.set_second_timer_ms
# =3000, a second-stage timer read only by nt-services.jar, which we do not ship.
# Revisit once the flicker is understood. See docs/vendor-props.md.
ro.surface_flinger.set_idle_timer_ms=3000
ro.surface_flinger.set_touch_timer_ms=200
# Stock sets 0, and blur is not free here: it forces SurfaceFlinger into client
# composition for the shade and quick settings, the only full-screen blur the
# device draws. Measured over five shade open/close cycles, disabling it halves
# the median SystemUI frame time (30ms -> 15ms) and drops jank from 41% to 14%.
# Kept enabled anyway -- it is a per-user appearance call, and Developer Options
# exposes it as "Disable window blurs" (Settings.Global disable_window_blurs).
ro.surface_flinger.supports_background_blur=1
ro.surface_flinger.use_color_management=true
ro.surface_flinger.use_content_detection_for_refresh_rate=true
ro.surface_flinger.wcg_composition_dataspace=143261696

# Incremental FS
ro.incremental.enable=yes

# Keymint
ro.crypto.metadata_init_delete_all_keys.enabled=true
ro.hardware.keystore_desede=true
vendor.gatekeeper.is_security_level_spu=0

# Media 
debug.stagefright.c2inputsurface=-1
debug.stagefright.omx_default_rank=0
vendor.qc2audio.per_frame.flac.dec.enabled=true
vendor.qc2audio.suspend.enabled=true 

# Perf
ro.vendor.extension_library=libqti-perfd-client.so
vendor.perf.framepacing.enable=1

# RIL
persist.radio.multisim.config=dsds
persist.vendor.radio.apm_sim_not_pwdn=1
persist.vendor.radio.custom_ecc=1
persist.vendor.radio.enableadvancedscan=true
persist.vendor.radio.procedure_bytes=SKIP
persist.vendor.radio.sib16_support=1 

# Sensors
persist.vendor.sensorhub.timeout_reset_threshold=20
persist.vendor.sensors.enable.mag_filter=true

# ScrollOptimizer
persist.sys.perf.scroll_opt=true
persist.sys.perf.scroll_opt.heavy_app=2

# SoC
ro.soc.manufacturer=QTI

# SSR
persist.vendor.ssr.restart_level=ALL_ENABLE

# Telephony
persist.vendor.rcs.singlereg.feature=1
telephony.active_modems.max_count=2 

# QMS
persist.vendor.data.qms.stx_disable=true

# USB
sys.usb.mtp.batchcancel=1
vendor.usb.controller=a600000.dwc3
vendor.usb.diag.func.name=ffs
vendor.usb.dpl.inst.name=dpl
vendor.usb.qdss.inst.name=qdss_sw
vendor.usb.rmnet.func.name=gsi
vendor.usb.rmnet.inst.name=rmnet
vendor.usb.rndis.func.name=gsi
vendor.usb.use_ffs_mtp=1
vendor.usb.use_gadget_hal=1

# Vibrator
vendor.vibrator.device=/dev/aac_richtap

# Wi-Fi
wifi.aware.interface=wifi-aware0

