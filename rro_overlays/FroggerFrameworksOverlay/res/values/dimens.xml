<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default radius of the software rounded corners. -->
    <dimen name="rounded_corner_radius">100px</dimen>

    <!-- Height of the status bar.
         Do not read this dimen directly. Use {@link SystemBarUtils#getStatusBarHeight} instead.

         162px is the height the punch hole imposes: config_mainBuiltInDisplayCutout
         reaches y=162, so the StatusBar window is laid out fillx162 and the
         statusBars inset is 162 whatever this dimen says. Anything smaller here is
         only read by consumers that ignore the inset, such as the shade header: it
         centres its clock in this value, which at 126px put it 26px too high.
         -->
    <dimen name="status_bar_height">162px</dimen>

    <!-- The default height of the status bar used in {@link SystemBarUtils#getStatusBarHeight} to
         calculate the status bar height. -->
    <dimen name="status_bar_height_default">162px</dimen>

    <!-- Height of the status bar in landscape.
         Do not read this dimen directly. Use {@link SystemBarUtils#getStatusBarHeight} instead.
         -->
    <dimen name="status_bar_height_landscape">36dp</dimen>

    <!-- Height of the status bar in portrait.
         Do not read this dimen directly. Use {@link SystemBarUtils#getStatusBarHeight} instead.
         -->
    <dimen name="status_bar_height_portrait">162px</dimen>
</resources>
